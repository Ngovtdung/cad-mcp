<!-- Giao diện palette Claude (nhúng vào ClaudePalette.dll). Màu, cỡ, khoảng cách đo từ palette Properties
     của AutoCAD 2022 (theme tối, 96 DPI) qua MCP. Sửa xong chạy build.cmd. -->
<Grid xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation'
           xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml'
           x:Name='Page' AllowDrop='True' Background='#3B4453'
           TextElement.Foreground='#F5F5F5' TextElement.FontFamily='Segoe UI' TextElement.FontSize='12'
           TextOptions.TextFormattingMode='Display' UseLayoutRounding='True' SnapsToDevicePixels='True'>
  <Grid.Resources>
    <SolidColorBrush x:Key='Head' Color='#2E3440'/>   <!-- thanh tiêu đề nhóm, đường kẻ lưới -->
    <SolidColorBrush x:Key='Field' Color='#4E5A6E'/>  <!-- ô chọn / ô nhập / nút -->
    <SolidColorBrush x:Key='FieldEdge' Color='#2A303B'/>
    <SolidColorBrush x:Key='Label' Color='#D9DBDD'/>
    <SolidColorBrush x:Key='Text' Color='#F5F5F5'/>
    <SolidColorBrush x:Key='Dim' Color='#A9B1BE'/>
    <SolidColorBrush x:Key='Hover' Color='#4A5A72'/>

    <!-- gạch chân hạ thấp: mặc định gạch sát baseline che dấu chấm dưới của tiếng Việt (ạ ụ ộ); PenOffset tính bằng pixel dưới baseline -->
    <TextDecorationCollection x:Key='LinkUnderline'><TextDecoration Location='Underline' PenOffset='2' PenOffsetUnit='Pixel'/></TextDecorationCollection>
    <Style x:Key='Link' TargetType='TextBlock'>
      <Setter Property='Foreground' Value='#6CB6FF'/>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='TextDecorations' Value='{StaticResource LinkUnderline}'/>
    </Style>

    <!-- menu "Quản lý" của hàng Skill: tông tối như palette (nền #3B4453, viền #2E3440, chữ Label, hover Hover), không bóng đổ. Style CÓ KHOÁ: chỉ áp cho menu này, không đụng ContextMenu khác -->
    <Style x:Key='DarkMenu' TargetType='ContextMenu'>
      <Setter Property='FontFamily' Value='Segoe UI'/>
      <Setter Property='FontSize' Value='12'/>
      <Setter Property='Foreground' Value='{StaticResource Label}'/>
      <Setter Property='HasDropShadow' Value='False'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='ContextMenu'>
            <Border Background='#3B4453' BorderBrush='{StaticResource Head}' BorderThickness='1' Padding='0,2'><ItemsPresenter/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key='DarkMenuItem' TargetType='MenuItem'>
      <Setter Property='Foreground' Value='{StaticResource Label}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='MenuItem'>
            <Border x:Name='b' Background='Transparent' Padding='10,3,18,3'><ContentPresenter ContentSource='Header' RecognizesAccessKey='True'/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsHighlighted' Value='True'><Setter TargetName='b' Property='Background' Value='{StaticResource Hover}'/></Trigger>
              <Trigger Property='IsEnabled' Value='False'><Setter TargetName='b' Property='Opacity' Value='0.45'/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- lưới thuộc tính: ô nhãn | ô giá trị, cao 19px, kẻ #2E3440 -->
    <Style x:Key='Key' TargetType='Border'>
      <Setter Property='BorderBrush' Value='{StaticResource Head}'/>
      <Setter Property='BorderThickness' Value='1,0,0,1'/>
      <Setter Property='Padding' Value='5,1,4,1'/>
      <Setter Property='Height' Value='19'/>
      <Setter Property='TextElement.Foreground' Value='{StaticResource Label}'/>
    </Style>
    <Style x:Key='Val' TargetType='Border'>
      <Setter Property='BorderBrush' Value='{StaticResource Head}'/>
      <Setter Property='BorderThickness' Value='1,0,1,1'/>
      <Setter Property='Padding' Value='3,1,2,1'/>
      <Setter Property='Height' Value='19'/>
    </Style>
    <!-- ô bấm phím tắt: trông như chữ trong ô giá trị, có focus thì nền Hover -->
    <Style x:Key='HotkeyBox' TargetType='TextBox'>
      <Setter Property='IsReadOnly' Value='True'/>
      <Setter Property='IsReadOnlyCaretVisible' Value='False'/>
      <Setter Property='IsUndoEnabled' Value='False'/>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='Foreground' Value='{StaticResource Text}'/>
      <Setter Property='Background' Value='Transparent'/>
      <Setter Property='BorderThickness' Value='0'/>
      <Setter Property='Padding' Value='0'/>
      <Setter Property='FocusVisualStyle' Value='{x:Null}'/>
      <Setter Property='ToolTip' Value='Bấm vào rồi bấm tổ hợp phím (vd Ctrl+Shift+X). Delete hoặc × để tắt, Esc để thôi.'/>
      <Style.Triggers>
        <Trigger Property='IsKeyboardFocused' Value='True'><Setter Property='Background' Value='{StaticResource Hover}'/></Trigger>
      </Style.Triggers>
    </Style>
    <!-- ô nhập API key: như HotkeyBox, trông như chữ trong ô giá trị -->
    <Style x:Key='KeyBox' TargetType='PasswordBox'>
      <Setter Property='Foreground' Value='{StaticResource Text}'/>
      <Setter Property='CaretBrush' Value='White'/>
      <Setter Property='Background' Value='Transparent'/>
      <Setter Property='BorderThickness' Value='0'/>
      <Setter Property='Padding' Value='0'/>
      <Setter Property='FocusVisualStyle' Value='{x:Null}'/>
      <Style.Triggers>
        <Trigger Property='IsKeyboardFocused' Value='True'><Setter Property='Background' Value='{StaticResource Hover}'/></Trigger>
      </Style.Triggers>
    </Style>
    <!-- dòng bấm được (gợi ý lệnh) -->
    <Style x:Key='Item' TargetType='Border'>
      <Setter Property='Background' Value='Transparent'/>
      <Setter Property='BorderBrush' Value='{StaticResource Head}'/>
      <Setter Property='BorderThickness' Value='1,0,1,1'/>
      <Setter Property='Padding' Value='5,1,4,1'/>
      <Setter Property='MinHeight' Value='19'/>
      <Setter Property='Cursor' Value='Hand'/>
      <Style.Triggers>
        <Trigger Property='IsMouseOver' Value='True'><Setter Property='Background' Value='{StaticResource Hover}'/></Trigger>
      </Style.Triggers>
    </Style>

    <!-- chữ trong khung hội thoại: chọn/copy được, không viền -->
    <Style x:Key='Msg' TargetType='TextBox'>
      <Setter Property='IsReadOnly' Value='True'/>
      <Setter Property='TextWrapping' Value='Wrap'/>
      <Setter Property='Background' Value='Transparent'/>
      <Setter Property='Foreground' Value='{StaticResource Text}'/>
      <Setter Property='BorderThickness' Value='0'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='TextBox'>
            <ScrollViewer x:Name='PART_ContentHost' Focusable='False' VerticalScrollBarVisibility='Disabled'/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType='Button'>
      <Setter Property='Foreground' Value='{StaticResource Text}'/>
      <Setter Property='Height' Value='22'/>
      <Setter Property='MinWidth' Value='60'/>
      <Setter Property='Padding' Value='10,0'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Button'>
            <Border x:Name='b' Background='{StaticResource Field}' BorderBrush='{StaticResource FieldEdge}' BorderThickness='1' Padding='{TemplateBinding Padding}'>
              <ContentPresenter HorizontalAlignment='Center' VerticalAlignment='Center'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='b' Property='Background' Value='#5A6880'/></Trigger>
              <Trigger Property='IsPressed' Value='True'><Setter TargetName='b' Property='Background' Value='#3B4453'/></Trigger>
              <Trigger Property='IsEnabled' Value='False'><Setter TargetName='b' Property='Opacity' Value='0.45'/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='IconBtn' TargetType='Button' BasedOn='{StaticResource {x:Type Button}}'>
      <Setter Property='MinWidth' Value='22'/>
      <Setter Property='Width' Value='22'/>
      <Setter Property='Padding' Value='0'/>
      <Setter Property='FontFamily' Value='Segoe MDL2 Assets'/>
      <Setter Property='FontSize' Value='12'/>
    </Style>
    <!-- chip tệp đính kèm: cao 19 như dòng Properties -->
    <Style x:Key='Chip' TargetType='Border'>
      <Setter Property='Background' Value='{StaticResource Field}'/>
      <Setter Property='BorderBrush' Value='{StaticResource FieldEdge}'/>
      <Setter Property='BorderThickness' Value='1'/>
      <Setter Property='Height' Value='19'/>
      <Setter Property='Padding' Value='5,0,3,0'/>
      <Setter Property='Margin' Value='0,0,4,4'/>
    </Style>

    <Style TargetType='ScrollBar'>
      <Setter Property='Width' Value='8'/>
      <Setter Property='MinWidth' Value='8'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='ScrollBar'>
            <Track x:Name='PART_Track' IsDirectionReversed='True'>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType='Thumb'><Border Background='#66738A' Margin='2,0'/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- như ô giá trị trong Properties: chỉ hiện mũi tên khi rê chuột -->
    <Style TargetType='ComboBox'>
      <Setter Property='Foreground' Value='{StaticResource Text}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='ComboBox'>
            <Grid Background='Transparent'>
              <ToggleButton Focusable='False' ClickMode='Press'
                            IsChecked='{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}'>
                <ToggleButton.Template>
                  <ControlTemplate TargetType='ToggleButton'>
                    <Border Background='Transparent'>
                      <Path x:Name='arrow' HorizontalAlignment='Right' VerticalAlignment='Center' Margin='0,0,3,0'
                            Data='M0,0 L7,0 3.5,4 Z' Fill='#D9D9D9' Visibility='Hidden'/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='arrow' Property='Visibility' Value='Visible'/></Trigger>
                      <Trigger Property='IsChecked' Value='True'><Setter TargetName='arrow' Property='Visibility' Value='Visible'/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible='False' Margin='0,0,12,0' VerticalAlignment='Center'
                                Content='{TemplateBinding SelectionBoxItem}' ContentTemplate='{TemplateBinding SelectionBoxItemTemplate}'/>
              <Popup x:Name='PART_Popup' IsOpen='{TemplateBinding IsDropDownOpen}' Placement='Bottom' AllowsTransparency='True' Focusable='False'>
                <Border Background='{StaticResource Field}' BorderBrush='{StaticResource FieldEdge}' BorderThickness='1' MinWidth='{TemplateBinding ActualWidth}'>
                  <ScrollViewer MaxHeight='260'><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType='ComboBoxItem'>
      <Setter Property='Foreground' Value='{StaticResource Text}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='ComboBoxItem'>
            <Border x:Name='b' Background='Transparent' Padding='5,2'><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsHighlighted' Value='True'><Setter TargetName='b' Property='Background' Value='#0696D7'/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- nhóm: thanh 20px #2E3440, chữ đậm, tam giác bên phải; bấm để thu gọn. Lề trái 17px như Properties -->
    <Style x:Key='Section' TargetType='Expander'>
      <Setter Property='IsExpanded' Value='True'/>
      <Setter Property='Foreground' Value='{StaticResource Text}'/>
      <Setter Property='Margin' Value='17,0,4,0'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Expander'>
            <DockPanel>
              <ToggleButton DockPanel.Dock='Top' Content='{TemplateBinding Header}' Foreground='{StaticResource Text}'
                            IsChecked='{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}'>
                <ToggleButton.Template>
                  <ControlTemplate TargetType='ToggleButton'>
                    <Border Background='{StaticResource Head}' Height='20' Padding='7,0,9,0'>
                      <DockPanel>
                        <Path x:Name='tri' DockPanel.Dock='Right' VerticalAlignment='Center' Data='M0,0 L8,0 4,4 Z' Fill='#D9D9D9'/>
                        <ContentPresenter VerticalAlignment='Center' TextElement.FontWeight='Bold'/>
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property='IsChecked' Value='False'><Setter TargetName='tri' Property='Data' Value='M4,0 L4,8 0,4 Z'/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <!-- nội dung thụt thêm 17px như lưới Properties -->
              <ContentPresenter x:Name='body' Margin='17,0,0,0'/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property='IsExpanded' Value='False'><Setter TargetName='body' Property='Visibility' Value='Collapsed'/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <DockPanel>

  <!-- thanh trạng thái -->
  <Border DockPanel.Dock='Bottom' Background='{StaticResource Head}' Height='20' Padding='7,0'>
    <DockPanel>
      <TextBlock x:Name='ModelLabel' DockPanel.Dock='Right' Foreground='{StaticResource Dim}' VerticalAlignment='Center' Margin='8,0,0,0'/>
      <TextBlock x:Name='Status' Foreground='{StaticResource Label}' VerticalAlignment='Center' Text='Sẵn sàng' TextTrimming='CharacterEllipsis'/>
    </DockPanel>
  </Border>

  <!-- tệp đính kèm + ô nhập + nút -->
  <StackPanel DockPanel.Dock='Bottom' Margin='17,6,4,6'>
    <WrapPanel x:Name='Chips' Visibility='Collapsed'/>
    <Grid>
      <TextBox x:Name='Input' MinHeight='54' MaxHeight='160' TextWrapping='Wrap' AcceptsReturn='True' VerticalScrollBarVisibility='Auto'
               Background='{StaticResource Field}' Foreground='{StaticResource Text}' BorderBrush='{StaticResource FieldEdge}' CaretBrush='White' Padding='2'/>
      <TextBlock x:Name='Hint' Margin='6,4' IsHitTestVisible='False' Foreground='{StaticResource Dim}' TextWrapping='Wrap'
                 Text='Nhập yêu cầu cho Claude... (Enter gửi, Shift+Enter xuống dòng, Esc dừng; Ctrl+V/kéo thả để đính kèm)'/>
    </Grid>
    <DockPanel Margin='0,6,0,0' LastChildFill='False'>
      <Button x:Name='AttachBtn' Style='{StaticResource IconBtn}' Content='&#xE723;'
              ToolTip='Đính kèm tệp: ảnh, PDF, văn bản, Excel (hoặc Ctrl+V, kéo thả). Tệp được gửi lên Anthropic cùng tin nhắn. Chỉ đính kèm tệp bạn tin.'/>
      <Button x:Name='CaptureBtn' Style='{StaticResource IconBtn}' Content='&#xE7A8;' Margin='4,0,0,0' ToolTip='Chụp vùng màn hình (palette tạm ẩn; Esc huỷ)'/>
      <Button x:Name='SendBtn' DockPanel.Dock='Right' Content='Gửi' ToolTip='Gửi (Enter)'/>
      <Button x:Name='StopBtn' DockPanel.Dock='Right' Content='Dừng' Margin='0,0,4,0' IsEnabled='False' ToolTip='Dừng (Esc)'/>
      <Button x:Name='NewBtn' DockPanel.Dock='Right' Content='Mới' Margin='0,0,4,0' ToolTip='Hội thoại mới'/>
    </DockPanel>
  </StackPanel>

  <Expander x:Name='SettingsSection' DockPanel.Dock='Top' Style='{StaticResource Section}' Header='Cài đặt' IsExpanded='False' Margin='17,3,4,0'>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width='45*'/><ColumnDefinition Width='55*'/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <Border Style='{StaticResource Key}'><TextBlock Text='Model'/></Border>
      <Border Style='{StaticResource Val}' Grid.Column='1'><ComboBox x:Name='Model'/></Border>
      <Border Style='{StaticResource Key}' Grid.Row='1'><TextBlock Text='Mức suy nghĩ'/></Border>
      <Border Style='{StaticResource Val}' Grid.Row='1' Grid.Column='1'><ComboBox x:Name='Effort'/></Border>
      <Border Style='{StaticResource Key}' Grid.Row='2' ToolTip='Có: tự gửi kèm handle các đối tượng đang chọn trong bản vẽ'>
        <TextBlock Text='Kèm đối tượng chọn' TextTrimming='CharacterEllipsis'/>
      </Border>
      <Border Style='{StaticResource Val}' Grid.Row='2' Grid.Column='1'><ComboBox x:Name='WithSelection'/></Border>
      <Border Style='{StaticResource Key}' Grid.Row='3' ToolTip='Chỉ khi AutoCAD đang ở trước (không chiếm phím của chương trình khác).'>
        <TextBlock Text='Phím chụp vùng' TextTrimming='CharacterEllipsis'/>
      </Border>
      <Border Style='{StaticResource Val}' Grid.Row='3' Grid.Column='1'>
        <DockPanel>
          <TextBlock x:Name='HotkeyCaptureClear' DockPanel.Dock='Right' Text='×' Foreground='{StaticResource Dim}' Cursor='Hand' Margin='4,0,2,0' ToolTip='Tắt phím tắt này'/>
          <TextBox x:Name='HotkeyCapture' Style='{StaticResource HotkeyBox}'/>
        </DockPanel>
      </Border>
      <Border Style='{StaticResource Key}' Grid.Row='4' ToolTip='Chỉ trong AutoCAD, như Ctrl+1 với Properties. Lệnh CLAUDE cũng bật/tắt.'>
        <TextBlock Text='Phím ẩn/hiện palette' TextTrimming='CharacterEllipsis'/>
      </Border>
      <Border Style='{StaticResource Val}' Grid.Row='4' Grid.Column='1'>
        <DockPanel>
          <TextBlock x:Name='HotkeyToggleClear' DockPanel.Dock='Right' Text='×' Foreground='{StaticResource Dim}' Cursor='Hand' Margin='4,0,2,0' ToolTip='Tắt phím tắt này'/>
          <TextBox x:Name='HotkeyToggle' Style='{StaticResource HotkeyBox}'/>
        </DockPanel>
      </Border>
      <Border Style='{StaticResource Key}' Grid.Row='5'><TextBlock Text='Gợi ý (goi_y.txt)' TextTrimming='CharacterEllipsis'/></Border>
      <Border Style='{StaticResource Val}' Grid.Row='5' Grid.Column='1'>
        <StackPanel Orientation='Horizontal'>
          <TextBlock x:Name='EditSuggestions' Text='Sửa' Foreground='#6CB6FF' Cursor='Hand' TextDecorations='{StaticResource LinkUnderline}'/>
          <TextBlock x:Name='ReloadSuggestions' Text='Nạp lại' Foreground='#6CB6FF' Cursor='Hand' TextDecorations='{StaticResource LinkUnderline}' Margin='10,0,0,0'/>
        </StackPanel>
      </Border>
      <!-- skill (3.1.1): nhãn | [chữ trạng thái giãn][link "Quản lý ▾" mở menu]. Grid Margin phải 14 = ô nút × của hàng API key: link thẳng mép phải với "Lưu" -->
      <Border Style='{StaticResource Key}' Grid.Row='6' ToolTip='Agent Skills: hướng dẫn cách làm do bạn viết hoặc nạp (SKILL.md). Skill là chương trình chạy với quyền của bạn: chỉ nạp skill bạn đã đọc hoặc tin nguồn.'><TextBlock Text='Skill'/></Border>
      <Border Style='{StaticResource Val}' Grid.Row='6' Grid.Column='1'>
        <Grid Margin='0,0,14,0'>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
          <TextBlock x:Name='SkillStatus' TextTrimming='CharacterEllipsis'/>
          <TextBlock x:Name='SkillManage' Grid.Column='1' Style='{StaticResource Link}' Text='Quản lý ▾' Margin='6,0,0,0' ToolTip='Mở thư mục skill, tạo skill mới hoặc nạp skill'>
            <TextBlock.ContextMenu>
              <ContextMenu x:Name='SkillMenu' Style='{StaticResource DarkMenu}' ItemContainerStyle='{StaticResource DarkMenuItem}' Placement='Bottom'>
                <MenuItem x:Name='MenuOpenSkills' Header='Mở thư mục skill' ToolTip='Mở thư mục skill trong Explorer'/>
                <MenuItem x:Name='MenuNewSkill' Header='Tạo skill mới' ToolTip='Tạo skill mẫu và mở bằng Notepad'/>
                <MenuItem x:Name='MenuImportSkill' Header='Nạp skill…' ToolTip='Nạp skill từ SKILL.md hoặc .zip (kể cả bản nháp Claude soạn)'/>
              </ContextMenu>
            </TextBlock.ContextMenu>
          </TextBlock>
        </Grid>
      </Border>
      <Border Style='{StaticResource Key}' Grid.Row='7' ToolTip='Tài khoản Claude: đăng nhập bằng /login. API key: key của console.anthropic.com.'><TextBlock Text='Đăng nhập'/></Border>
      <Border Style='{StaticResource Val}' Grid.Row='7' Grid.Column='1'><ComboBox x:Name='AuthMode'/></Border>
      <Border x:Name='ApiKeyLabel' Style='{StaticResource Key}' Grid.Row='8'><TextBlock Text='API key'/></Border>
      <Border x:Name='ApiKeyVal' Style='{StaticResource Val}' Grid.Row='8' Grid.Column='1'>
        <DockPanel>
          <TextBlock x:Name='ApiKeyClear' DockPanel.Dock='Right' Text='×' Foreground='{StaticResource Dim}' Cursor='Hand' Margin='4,0,2,0' ToolTip='Xoá key đã lưu'/>
          <TextBlock x:Name='ApiKeySave' DockPanel.Dock='Right' Text='Lưu' Foreground='#6CB6FF' Cursor='Hand' TextDecorations='{StaticResource LinkUnderline}' Margin='6,0,0,0' ToolTip='Lưu key (mã hoá theo tài khoản Windows)'/>
          <TextBlock x:Name='ApiKeyPaste' DockPanel.Dock='Right' Text='Dán &amp; lưu' Foreground='#6CB6FF' Cursor='Hand' TextDecorations='{StaticResource LinkUnderline}' Margin='6,0,0,0' ToolTip='Dán key từ clipboard và lưu ngay (không cần bấm vào ô)'/>
          <PasswordBox x:Name='ApiKeyBox' Style='{StaticResource KeyBox}' ToolTip='Dùng key riêng cho AutoCAD, đặt hạn mức chi cho workspace trong Console. Mã do Claude chạy (run_python) vẫn có thể đọc được key nếu bị nội dung bản vẽ/tệp đính kèm lừa.'/>
        </DockPanel>
      </Border>
      <TextBlock x:Name='AuthStatus' Grid.Row='9' Grid.ColumnSpan='2' Foreground='{StaticResource Dim}' TextWrapping='Wrap' Margin='4,2,4,4'/>
    </Grid>
  </Expander>

  <Expander DockPanel.Dock='Top' Style='{StaticResource Section}'>
    <Expander.Header>
      <StackPanel Orientation='Horizontal'>
        <TextBlock Text='Gợi ý lệnh' FontWeight='Bold'/>
        <TextBlock x:Name='SugCount' Foreground='{StaticResource Dim}' FontWeight='Normal' Margin='6,0,0,0'/>
      </StackPanel>
    </Expander.Header>
    <ScrollViewer MaxHeight='172' VerticalScrollBarVisibility='Auto'>
      <StackPanel x:Name='Suggestions'/>
    </ScrollViewer>
  </Expander>

  <Expander Style='{StaticResource Section}' Header='Hội thoại'>
    <Border BorderBrush='{StaticResource Head}' BorderThickness='1,0,1,1'>
      <ScrollViewer x:Name='LogScroll' VerticalScrollBarVisibility='Auto'>
        <StackPanel x:Name='Log' Margin='5,2,5,6'/>
      </ScrollViewer>
    </Border>
  </Expander>
  </DockPanel>
  <!-- lớp phủ khi kéo tệp vào palette (ClaudeUi.ShowDropHint) -->
  <Border x:Name='DropHint' Visibility='Collapsed' IsHitTestVisible='False' Margin='4'
          Background='#CC2E3440' BorderBrush='#0696D7' BorderThickness='1'>
    <TextBlock Text='Thả tệp vào đây để đính kèm' HorizontalAlignment='Center' VerticalAlignment='Center' Foreground='{StaticResource Text}'/>
  </Border>
</Grid>
